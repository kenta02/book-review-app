# ========================================
# 基本（Node.js 共通）
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# lockファイル（使うパッケージマネージャ1つだけ残す）
package-lock.json
yarn.lock
.pnpm-store/


# ========================================
# ビルド成果物（React / Node）
# ========================================
dist/
build/
out/
*.tsbuildinfo

# ========================================
# OS依存ファイル
# ========================================
.DS_Store
Thumbs.db

# ========================================
# エディタ・IDE
# ========================================
.vscode/
.idea/
*.swp
.history/
*.suo
*.ntvs*
*.njsproj
*.sln

# ========================================
# 環境ファイル・認証情報
# ========================================
.env
.env.*
*.local
*.pem
*.key
*.crt

# ========================================
# ログ/キャッシュ
# ========================================
logs/
*.log
npm-debug.log*
pidfiles
coverage/

# ========================================
# DB / Sequelize
# ========================================
config/config.json

# ========================================
# macOS固有のファイル
# ========================================
.AppleDouble
.LSOverride

# ========================================
# Nodeサーバの一時ファイル
# ========================================
*.pid
*.seed
*.pid.lock

# ========================================
# その他
# ========================================
tmp/
temp/
.cache/
kadai.txt


# ドキュメント類
docs/*
!docs/adr/
.copilot-instructions
book-review-app.code-workspace
CODING_GUIDELINES.md
server/docs.code-workspace
.gitnexus
# AI 設定のローカル専用ファイル（個人設定のみ。AGENTS.md / CLAUDE.md / .agents/skills/ / .claude/skills/ は共有）
CLAUDE.local.md
PROJECT_MEMORY.local.md
.claude/settings.local.json

# AI 設定の補助ファイル
PROJECT_MEMORY.md
.mcp.json
.github/hooks/
.github/mcp/
.github/skills/

# Codacy の自動生成ファイル
.github/instructions/codacy.instructions.md
